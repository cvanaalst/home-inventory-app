{
  "name": "Inventory",
  "short_name": "Inventory",
  "description": "Local-first inventory for workshop storage.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#14171c",
  "theme_color": "#14171c",
  "lang": "nl",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Foto vastleggen",
      "short_name": "Vastleggen",
      "description": "Direct naar foto's maken voor een container",
      "url": "./#view-capture",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Zoeken",
      "short_name": "Zoeken",
      "description": "Items, containers en locaties doorzoeken",
      "url": "./#view-search",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "./share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "photos", "accept": ["image/*"] }]
    }
  }
}
